<?xml version="1.0" encoding="utf-8"?>
<!-- tab switcher sheet: M3 bottom sheet with letter-avatar rows -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="16dp"
    android:background="@color/surface">

    <View
        android:layout_width="24dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_drag_handle" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/tabCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/tabs_title"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="@color/on_surface" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNewTab"
            style="@style/Comet.Button.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="@string/new_tab"
            android:textSize="13sp"
            app:icon="@drawable/ic_add"
            app:iconSize="16dp"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconTint="@color/on_secondary_container" />
    </LinearLayout>

    <ListView
        android:id="@+id/tabList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:paddingHorizontal="8dp"
        android:clipToPadding="false"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />
</LinearLayout>
