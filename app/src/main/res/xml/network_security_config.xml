<?xml version="1.0" encoding="utf-8"?>
<!--
  Network security: cleartext HTTP is blocked everywhere EXCEPT loopback,
  which exists solely for the built-in local test-page server used by the
  agent test harness (http://127.0.0.1:<port>). All user traffic is TLS-only.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
