<?xml version="1.0" encoding="utf-8"?>
<!--
  Comet-X v2.0.0 launcher foreground — the comet: a glowing head with a
  tapered three-band trail sweeping across the safe zone. Built from filled
  tapered shapes (vector strokes cannot carry gradients), so the trail fades
  from bright white-violet at the head to translucent violet at the tail.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- outer trail (softest, widest) -->
    <path
        android:fillColor="#5E7C3AED"
        android:pathData="M68,46 C54,60 40,74 22,86 C21,87 22,89 24,88 C43,78 58,64 72,50 Z" />
    <!-- mid trail -->
    <path
        android:fillColor="#8C8B5CF6"
        android:pathData="M70,43 C58,55 46,67 30,79 C28,80 29,82 31,81 C47,71 61,58 73,47 Z" />
    <!-- inner trail (brightest) -->
    <path
        android:fillColor="#E0DDD6FE"
        android:pathData="M73,41 C63,50 52,60 38,72 C37,73 38,74 39,74 C52,64 64,54 75,44 Z" />
    <!-- head glow -->
    <path android:pathData="M74,40 m-17,0 a17,17 0 1,1 34,0 a17,17 0 1,1 -34,0">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="74"
                android:centerY="40"
                android:gradientRadius="17"
                android:startColor="#88A78BFA"
                android:endColor="#00A78BFA" />
        </aapt:attr>
    </path>
    <!-- head -->
    <path android:pathData="M74,40 m-9.5,0 a9.5,9.5 0 1,1 19,0 a9.5,9.5 0 1,1 -19,0">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="71"
                android:centerY="37"
                android:gradientRadius="13"
                android:startColor="#FFFFFF"
                android:endColor="#D6C8FF" />
        </aapt:attr>
    </path>
    <!-- sparkle above the head -->
    <path
        android:fillColor="#CCFFFFFF"
        android:pathData="M88,26 L89.4,29.6 L93,31 L89.4,32.4 L88,36 L86.6,32.4 L83,31 L86.6,29.6 Z" />
</vector>
